# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API (or "API Keys").
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Receipt scanning (server only, keep secret): free key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-key
